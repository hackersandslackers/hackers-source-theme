<section class="gh-about sidebar-widget">
  {{#if @site.icon}}
    <img
      class="gh-about-icon"
      src="{{@site.icon}}"
      alt="{{@site.title}}"
      loading="lazy"
    />
  {{/if}}
  <h3 class="gh-about-title is-title">{{@site.title}}</h3>
  {{#if @site.description}}
    <p class="gh-about-description is-body">{{@site.description}}</p>
  {{/if}}
</section>